# PropIQ Environment Configuration — TEMPLATE
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# If a key was ever committed, ROTATE it immediately.

# ── Backend ────────────────────────────────────────────────────
DEBUG=true
APP_VERSION=3.0.0

# Postgres (source of truth). Falls back to local SQLite if unset.
DATABASE_URL=postgresql://propiq:propiq_dev_2026@postgres:5432/propiq
REDIS_URL=redis://redis:6379/0

# Security
# Comma-separated allowed API keys (X-API-Key header). Generate per-tenant keys.
PROPIQ_API_KEYS=propiq-demo-2026
# Comma-separated allowed browser origins for CORS (NOT "*").
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ───────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000

# ── Groq API (LLM chat, credit memos, VLM vision) ──────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ── MLOps stack (all optional — graceful degradation if absent) ─
# MLflow: leave unset to use the local file store at backend/data/mlruns
# MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=propiq-valuation
# Feast feature store (local registry by default; no server required)
ENABLE_FEAST=false
# Drift thresholds (Population Stability Index)
DRIFT_PSI_WARN=0.1
DRIFT_PSI_ALERT=0.25

# ── Deep AIML layer (all optional; sensible fallbacks if unset/uninstalled) ─
# LLM routing (only "groq" wired today)
LLM_PROVIDER=groq
LLM_AGENT_PROVIDER=groq
# RAG / vector search:  auto -> chroma if installed, else in-memory numpy cosine
VECTOR_BACKEND=auto
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
# Fraud / duplicate detection cosine threshold
DUPLICATE_SIM_THRESHOLD=0.92
# Forecasting engine:  auto -> prophet/statsmodels if installed, else numpy
FORECAST_ENGINE=auto
# Knowledge graph backend:  auto -> networkx if installed, else dict adjacency
KG_BACKEND=auto

# ── Email alerts (optional; logs to console if unset) ──────────
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_TO_EMAIL=risk-team@example.com
